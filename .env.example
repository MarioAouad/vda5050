# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys (see the note in docs/ARCHITECTURE.md about the
# Sub-Project 2 key exposure this discipline exists because of).

# --- LLM providers --------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- mcp-server -------------------------------------------------------
QDRANT_COLLECTION=vda5050_baseline
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- Local (non-Docker) dev only ------------------------------------------
# These are unused by docker-compose (which sets DATA_DIR, QDRANT_URL,
# MCP_SERVER_URL, FRONTEND_ORIGIN directly — see docker-compose.yml) but
# are read as fallbacks if you run a service's uvicorn/python command
# directly on your host instead of through Docker.
# DATA_DIR=./data
# QDRANT_PATH=./data/qdrant_db
# QDRANT_URL=
# MCP_SERVER_URL=http://localhost:8001/mcp
# FRONTEND_ORIGIN=http://localhost:8080
